---
const produtos = [
  {
    num: '01',
    tag: 'Especialidade Principal',
    nome: 'Couro legítimo',
    desc: 'Referência nacional na seleção, divisão e acabamento de peles legítimas nobres para grandes coleções.',
    img: 'https://images.unsplash.com/photo-1594223274512-ad4803739b7c?auto=format&fit=crop&w=1200&q=85'
  },
  {
    num: '02',
    tag: 'Alto Giro & Escala',
    nome: 'Couro sintético',
    desc: 'Laminados tecnológicos de alta densidade com caimento impecável e precisão de costura.',
    img: 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=1200&q=85'
  },
  {
    num: '03',
    tag: 'Peças Estruturadas',
    nome: 'Acrílico',
    desc: 'Bolsas rígidas, clutches, alças e fechos esculturais com acabamento polido e encaixe milimétrico.',
    img: 'https://images.unsplash.com/photo-1566150905458-1bf1fc113f0d?auto=format&fit=crop&w=1200&q=85'
  },
  {
    num: '04',
    tag: 'Construções Híbridas',
    nome: 'Tecidos & tramas',
    desc: 'Lonas encorpadas, jacquard e fibras naturais combinadas a estrutura e acabamentos em couro.',
    img: 'https://images.unsplash.com/photo-1591561954557-26941169b49e?auto=format&fit=crop&w=1200&q=85'
  }
];

const etapas = [
  { num: '01', nome: 'Desenvolvimento', detalhe: 'Leitura de briefing e engenharia do produto' },
  { num: '02', nome: 'Modelagem', detalhe: 'Moldes digitais e aprovação de peça-piloto' },
  { num: '03', nome: 'Produção', detalhe: 'Corte, costura, pintura a fio e montagem' },
  { num: '04', nome: 'Entrega', detalhe: 'Inspeção final e expedição pronta para o varejo' }
];
---

<section class="section light" id="produtos">
  <div class="container">
    <div class="section-head reveal">
      <p class="label"><span>03</span>Produtos</p>
      <h2 class="title">Bolsas para as marcas mais exigentes do país.</h2>
    </div>

    <div class="produtos-accordion reveal" id="produtosAccordion">
      {produtos.map((p, idx) => (
        <article class={`prod-panel ${idx === 0 ? 'is-expanded' : ''}`} data-prod-panel={idx} tabindex="0">
          <img src={p.img} alt={`Foto produto · ${p.nome}`} loading="lazy" />
          <div class="prod-gradient"></div>

          <div class="prod-top-bar">
            <span class="prod-num">{p.num}</span>
            <span class="prod-tag">{p.tag}</span>
          </div>

          <div class="prod-caption">
            <h3>{p.nome}</h3>
            <p>{p.desc}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="etapas-wrapper reveal">
      <p class="label etapas-label">Esteira completa ponta a ponta</p>
      <ol class="etapas-grid">
        {etapas.map((e) => (
          <li class="etapa-card">
            <span class="etapa-num">{e.num}</span>
            <strong>{e.nome}</strong>
            <p>{e.detalhe}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const panels = document.querySelectorAll('[data-prod-panel]');
  panels.forEach((panel) => {
    const activate = () => {
      panels.forEach((p) => p.classList.remove('is-expanded'));
      panel.classList.add('is-expanded');
    };
    panel.addEventListener('mouseenter', activate);
    panel.addEventListener('focus', activate);
    panel.addEventListener('click', activate);
  });
</script>
