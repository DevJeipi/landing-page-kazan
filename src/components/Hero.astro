---
import Photo from './Photo.astro';
---

<section class="hero dark" id="topo">
  <div class="hero-watermark" aria-hidden="true">KAZAN</div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="label reveal">Indústria de bolsas · Campo Bom, RS</p>
      <h1 class="hero-title reveal">
        Do desenvolvimento do modelo<br class="hero-br" />
        <span class="hero-title-accent">ao produto entregue.</span>
      </h1>
      <p class="text hero-text reveal">
        Manufatura completa de bolsas para as principais marcas do país, com reconhecida excelência em couro legítimo.
      </p>
      <div class="hero-actions reveal">
        <a href="#contato" class="btn">
          <span>Iniciar projeto</span>
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12m0 0L7.5 1.5M13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.3"></path>
          </svg>
        </a>
        <a href="#produtos" class="hero-link">Explorar produtos</a>
      </div>

      <div class="hero-pillars reveal">
        <div>
          <span class="hp-num">01</span>
          <span class="hp-label">Ponta a ponta</span>
        </div>
        <div>
          <span class="hp-num">02</span>
          <span class="hp-label">Couro legítimo</span>
        </div>
        <div>
          <span class="hp-num">03</span>
          <span class="hp-label">Grandes marcas</span>
        </div>
      </div>
    </div>

    <div class="hero-media reveal">
      <div class="hero-frame-primary">
        <Photo
          label="Foto 01 · Produção Kazan"
          src="https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=1200&q=85"
          ratio="4 / 5"
        />
      </div>
      <div class="hero-frame-accent">
        <Photo
          label="Detalhe · Acabamento"
          src="https://images.unsplash.com/photo-1594223274512-ad4803739b7c?auto=format&fit=crop&w=700&q=80"
          ratio="1 / 1"
        />
      </div>
    </div>
  </div>
</section>
