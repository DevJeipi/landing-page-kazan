---
import Photo from "./Photo.astro";
---

<section class="hero dark" id="topo">
  <div class="hero-watermark" aria-hidden="true">KAZAN</div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="label reveal">Indústria de bolsas · Campo Bom, RS</p>
      <h1 class="hero-title reveal">
        Do desenvolvimento do modelo<br class="hero-br" />
        <span class="hero-title-accent">ao produto entregue.</span>
      </h1>
      <p class="text hero-text reveal">
        Manufatura completa de bolsas para as principais marcas do país, com reconhecida excelência em couro legítimo.
      </p>
      <div class="hero-actions reveal">
        <a href="#contato" class="btn">
          <span>Iniciar projeto</span>
          <svg
            width="13"
            height="13"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 7h12m0 0L7.5 1.5M13 7l-5.5 5.5"
              stroke="currentColor"
              stroke-width="1.3"></path>
          </svg>
        </a>
        <a href="#produtos" class="hero-link">Explorar produtos</a>
      </div>

      <div class="hero-pillars reveal">
        <div>
          <span class="hp-num">01</span>
          <span class="hp-label">Ponta a ponta</span>
        </div>
        <div>
          <span class="hp-num">02</span>
          <span class="hp-label">Couro legítimo</span>
        </div>
        <div>
          <span class="hp-num">03</span>
          <span class="hp-label">Grandes marcas</span>
        </div>
      </div>
    </div>

    <div class="hero-media reveal">
      <div class="hero-frame-primary">
        <Photo
          label="Foto 01 · Produção Kazan"
          src="https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=1200&q=85"
          ratio="4 / 5"
        />
      </div>
      <div class="hero-frame-accent">
        <Photo
          label="Detalhe · Acabamento"
          src="https://images.unsplash.com/photo-1594223274512-ad4803739b7c?auto=format&fit=crop&w=700&q=80"
          ratio="1 / 1"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(3.5rem, 7vw, 5.5rem));
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .hero-watermark {
    position: absolute;
    right: -2%;
    bottom: -6%;
    font-size: clamp(7rem, 18vw, 17rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 0.85;
    color: rgba(235, 235, 235, 0.025);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-title {
    margin: 1.5rem 0;
    font-size: clamp(2rem, 3vw, 2.95rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    max-width: none;
  }

  .hero-br {
    display: block;
  }

  .hero-title-accent {
    font-weight: 300;
    color: var(--kz-a9);
  }

  @media (max-width: 640px) {
    .hero-br {
      display: inline;
    }
  }

  .hero-text {
    max-width: 44ch;
    font-size: 1.06rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .hero-link {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--kz-a9);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--kz-54);
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .hero-link:hover {
    color: var(--kz-eb);
    border-color: var(--kz-eb);
  }

  .hero-pillars {
    display: flex;
    gap: 2.5rem;
    margin-top: 3.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .hero-pillars div {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .hp-num {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--kz-54);
  }

  .hp-label {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kz-a9);
  }

  .hero-media {
    position: relative;
    max-width: 500px;
    width: 100%;
    justify-self: end;
    padding-left: 2.5rem;
    padding-bottom: 2rem;
  }

  .hero-frame-primary {
    box-shadow: 0 28px 64px rgba(0, 0, 0, 0.55);
  }

  .hero-frame-primary :global(.photo-tag) {
    justify-content: flex-end;
  }

  .hero-frame-accent :global(.photo-tag) {
    display: none;
  }

  .hero-frame-accent {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 42%;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.75);
    border: 4px solid var(--kz-0b);
    z-index: 3;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-media {
      justify-self: stretch;
      max-width: none;
      padding-left: 1.5rem;
    }

    .hero-pillars {
      flex-wrap: wrap;
      gap: 1.25rem 2rem;
    }
  }
</style>
