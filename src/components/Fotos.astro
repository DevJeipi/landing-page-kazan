---
import Photo from './Photo.astro';

const fotos = [
  {
    titulo: 'Vista geral da fábrica',
    src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1400&q=80'
  },
  {
    titulo: 'Corte do couro',
    src: 'https://images.unsplash.com/photo-1531973576160-7125cd663d86?auto=format&fit=crop&w=900&q=80'
  },
  {
    titulo: 'Costura de precisão',
    src: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=900&q=80'
  },
  {
    titulo: 'Modelagem e protótipo',
    src: 'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=900&q=80'
  },
  {
    titulo: 'Acabamento e pintura a fio',
    src: 'https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=900&q=80'
  },
  {
    titulo: 'Produto finalizado',
    src: 'https://images.unsplash.com/photo-1594223274512-ad4803739b7c?auto=format&fit=crop&w=900&q=80'
  }
];
---

<section class="section dark" id="fotos">
  <div class="container">
    <div class="section-head reveal">
      <p class="label"><span>04</span>Fotos</p>
      <h2 class="title">Por dentro da fábrica.</h2>
    </div>

    <div class="galeria reveal">
      {fotos.map((f, i) => (
        <Photo
          label={`Foto ${String(i + 1).padStart(2, '0')} · ${f.titulo}`}
          src={f.src}
          class={`g-${i + 1}`}
        />
      ))}
    </div>
  </div>
</section>
