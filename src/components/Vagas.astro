---
/**
 * GESTÃO AUTOMÁTICA DE VAGAS (ZERO MANUTENÇÃO NO CÓDIGO):
 *
 * 1. Para que o próprio RH da Kazan atualize as vagas sozinho pelo Google Sheets:
 *    - Crie uma planilha com as colunas: Cargo | Setor | Tipo | Status
 *    - No Google Sheets, vá em: Arquivo > Compartilhar > Publicar na Web > Formato CSV
 *    - Cole o link gerado na constante `GOOGLE_SHEETS_CSV_URL` abaixo.
 *
 * 2. Enquanto `GOOGLE_SHEETS_CSV_URL` estiver vazio (ou se a planilha não tiver vagas abertas),
 *    a seção funciona automaticamente por Setores / Banco de Talentos e encaminha o candidato
 *    já filtrado para o WhatsApp ou E-mail do RH.
 */
const GOOGLE_SHEETS_CSV_URL = '';
const EMAIL_RH = 'rh@kazan.com.br';
const WHATSAPP_RH = '5551999999999'; // Substitua pelo número oficial do RH com DDD

const setoresPadrao = [
  { cargo: 'Costura de Bolsas', setor: 'Produção · Costura', tipo: 'Banco de talentos' },
  { cargo: 'Corte de Couro e Materiais', setor: 'Produção · Corte', tipo: 'Banco de talentos' },
  { cargo: 'Modelagem e Desenvolvimento', setor: 'Engenharia de Produto', tipo: 'Banco de talentos' },
  { cargo: 'Preparação, Pintura a Fio e Acabamento', setor: 'Ateliê & Acabamento', tipo: 'Banco de talentos' },
  { cargo: 'Revisão, Expedição e Administrativo', setor: 'Qualidade & Gestão', tipo: 'Banco de talentos' }
];
---

<section
  class="section light"
  id="vagas"
  data-sheets-url={GOOGLE_SHEETS_CSV_URL}
  data-email-rh={EMAIL_RH}
  data-whatsapp-rh={WHATSAPP_RH}
>
  <div class="container">
    <div class="section-head reveal">
      <p class="label"><span>05</span>Vagas & Carreiras</p>
      <h2 class="title">Faça parte da Kazan.</h2>
    </div>

    <div class="vagas-grid">
      <!-- Coluna Esquerda: Lista Dinâmica de Vagas / Setores -->
      <div class="vagas-col-list reveal">
        <div class="vagas-list-header">
          <span class="vagas-sublabel">Selecione a área ou vaga de interesse</span>
          <span class="vagas-live-badge" id="vagasStatusBadge">Inscrições abertas</span>
        </div>

        <ul class="areas" id="vagasList">
          {setoresPadrao.map((item, idx) => (
            <li>
              <button
                type="button"
                class={`vaga-row ${idx === 0 ? 'is-selected' : ''}`}
                data-vaga-cargo={item.cargo}
                data-vaga-setor={item.setor}
              >
                <div class="vaga-info">
                  <strong class="vaga-cargo">{item.cargo}</strong>
                  <span class="vaga-setor">{item.setor}</span>
                </div>
                <div class="vaga-meta">
                  <span class="areas-status">{item.tipo}</span>
                  <span class="vaga-arrow" aria-hidden="true">→</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna Direita: Candidatura Rápida Direta para o RH -->
      <div class="vagas-apply-card reveal">
        <span class="apply-eyebrow">Candidatura rápida</span>
        <h3 class="apply-title" id="selectedVagaTitle">{setoresPadrao[0].cargo}</h3>
        <p class="apply-sub" id="selectedVagaSetor">{setoresPadrao[0].setor}</p>

        <form class="apply-form" id="vagasForm">
          <input type="hidden" name="vaga" id="vagaInput" value={setoresPadrao[0].cargo} />

          <div class="apply-field">
            <input type="text" name="nome" id="candNome" placeholder="Seu nome completo" required />
          </div>

          <div class="apply-field">
            <input type="tel" name="telefone" id="candTel" placeholder="Seu WhatsApp / Telefone" required />
          </div>

          <div class="apply-field">
            <input
              type="text"
              name="experiencia"
              id="candExp"
              placeholder="Resumo da sua experiência na função"
              required
            />
          </div>

          <div class="apply-actions">
            <button type="submit" class="btn apply-submit">
              <span>Enviar para o RH</span>
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12m0 0L7.5 1.5M13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.3"/>
              </svg>
            </button>

            <a href={`mailto:${EMAIL_RH}?subject=Currículo · Kazan`} class="apply-email-link" id="directEmailLink">
              Ou anexar currículo por e-mail
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .vagas-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .vagas-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .vagas-sublabel {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .vagas-live-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    background: var(--kz-0b);
    color: var(--kz-eb);
  }

  .areas {
    list-style: none;
  }

  .vaga-row {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 1.35rem 1rem;
    text-align: left;
    font-family: var(--font);
    color: var(--kz-0b);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: background-color 0.3s ease, padding-left 0.3s var(--ease);
  }

  .vaga-row:hover,
  .vaga-row.is-selected {
    background: rgba(11, 11, 11, 0.055);
    padding-left: 1.4rem;
  }

  .vaga-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .vaga-cargo {
    font-size: 1.05rem;
    font-weight: 500;
  }

  .vaga-setor {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .vaga-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .areas-status {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .vaga-arrow {
    font-size: 0.95rem;
    color: var(--kz-54);
    transition: transform 0.3s var(--ease), color 0.3s ease;
  }

  .vaga-row:hover .vaga-arrow,
  .vaga-row.is-selected .vaga-arrow {
    transform: translateX(4px);
    color: var(--kz-0b);
  }

  /* Card de Candidatura Rápida */
  .vagas-apply-card {
    background: var(--kz-0b);
    color: var(--kz-eb);
    padding: clamp(2rem, 3.5vw, 2.75rem);
    border: 1px solid rgba(11, 11, 11, 0.15);
  }

  .apply-eyebrow {
    display: block;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--kz-a9);
    margin-bottom: 0.5rem;
  }

  .apply-title {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--kz-eb);
    line-height: 1.25;
  }

  .apply-sub {
    font-size: 0.85rem;
    color: var(--kz-a9);
    margin-top: 0.25rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(235, 235, 235, 0.12);
  }

  .apply-form {
    display: grid;
    gap: 1.25rem;
  }

  .apply-field input {
    width: 100%;
    padding: 0.85rem 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(235, 235, 235, 0.2);
    color: var(--kz-eb);
    font-family: var(--font);
    font-size: 0.95rem;
    font-weight: 300;
    outline: none;
    transition: border-color 0.25s ease;
  }

  .apply-field input::placeholder {
    color: var(--kz-54);
  }

  .apply-field input:focus {
    border-color: var(--kz-eb);
  }

  .apply-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .apply-submit {
    width: 100%;
    color: var(--kz-eb);
    border-color: var(--kz-eb);
  }

  .apply-submit::before {
    background: var(--kz-eb) !important;
  }

  .apply-submit:hover {
    color: var(--kz-0b) !important;
  }

  .apply-email-link {
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kz-a9);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .apply-email-link:hover {
    color: var(--kz-eb);
  }

  @media (max-width: 900px) {
    .vagas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const section = document.getElementById('vagas');
  const sheetsUrl = section?.getAttribute('data-sheets-url') || '';
  const emailRh = section?.getAttribute('data-email-rh') || 'rh@kazan.com.br';
  const listEl = document.getElementById('vagasList');
  const titleEl = document.getElementById('selectedVagaTitle');
  const setorEl = document.getElementById('selectedVagaSetor');
  const vagaInput = document.getElementById('vagaInput') as HTMLInputElement | null;
  const emailLink = document.getElementById('directEmailLink') as HTMLAnchorElement | null;
  const form = document.getElementById('vagasForm') as HTMLFormElement | null;

  function bindRowClicks() {
    const rows = document.querySelectorAll('.vaga-row');
    rows.forEach((row) => {
      row.addEventListener('click', () => {
        rows.forEach((r) => r.classList.remove('is-selected'));
        row.classList.add('is-selected');
        const cargo = row.getAttribute('data-vaga-cargo') || '';
        const setor = row.getAttribute('data-vaga-setor') || '';
        if (titleEl) titleEl.textContent = cargo;
        if (setorEl) setorEl.textContent = setor;
        if (vagaInput) vagaInput.value = cargo;
        if (emailLink) {
          emailLink.href = `mailto:${emailRh}?subject=${encodeURIComponent(`Currículo · ${cargo}`)}`;
        }
      });
    });
  }

  bindRowClicks();

  // Caso o RH configure uma planilha pública do Google Sheets (CSV), carrega as vagas automaticamente
  if (sheetsUrl && listEl) {
    fetch(sheetsUrl)
      .then((res) => res.text())
      .then((csvText) => {
        const lines = csvText
          .split(/\r?\n/)
          .map((l) => l.trim())
          .filter(Boolean);
        if (lines.length <= 1) return;

        const items = lines
          .slice(1)
          .map((line) => {
            const cols = line.split(',').map((c) => c.replace(/^"|"$/g, '').trim());
            return {
              cargo: cols[0] || '',
              setor: cols[1] || 'Kazan',
              tipo: cols[2] || 'Vaga aberta',
              status: (cols[3] || 'ativa').toLowerCase()
            };
          })
          .filter((v) => v.cargo && v.status !== 'inativa' && v.status !== 'oculta');

        if (items.length > 0) {
          listEl.innerHTML = items
            .map(
              (item, idx) => `
            <li>
              <button
                type="button"
                class="vaga-row ${idx === 0 ? 'is-selected' : ''}"
                data-vaga-cargo="${item.cargo}"
                data-vaga-setor="${item.setor}"
              >
                <div class="vaga-info">
                  <strong class="vaga-cargo">${item.cargo}</strong>
                  <span class="vaga-setor">${item.setor}</span>
                </div>
                <div class="vaga-meta">
                  <span class="areas-status">${item.tipo}</span>
                  <span class="vaga-arrow" aria-hidden="true">→</span>
                </div>
              </button>
            </li>`
            )
            .join('');

          if (titleEl) titleEl.textContent = items[0].cargo;
          if (setorEl) setorEl.textContent = items[0].setor;
          if (vagaInput) vagaInput.value = items[0].cargo;
          bindRowClicks();
        }
      })
      .catch(() => {
        // Mantém os setores padrão caso o link não esteja ativo
      });
  }

  // Envio direto sem exigir backend (abre o cliente de e-mail já preenchido para o RH)
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const vaga = vagaInput?.value || 'Banco de Talentos';
    const nome = (document.getElementById('candNome') as HTMLInputElement)?.value || '';
    const tel = (document.getElementById('candTel') as HTMLInputElement)?.value || '';
    const exp = (document.getElementById('candExp') as HTMLInputElement)?.value || '';

    const subject = encodeURIComponent(`Candidatura: ${vaga} · ${nome}`);
    const body = encodeURIComponent(
      `Olá, equipe de RH da Kazan!\n\n` +
        `Gostaria de me candidatar para a área/vaga: ${vaga}\n\n` +
        `• Nome: ${nome}\n` +
        `• Telefone/WhatsApp: ${tel}\n` +
        `• Experiência: ${exp}\n`
    );

    window.location.href = `mailto:${emailRh}?subject=${subject}&body=${body}`;
  });
</script>
