---
interface Props {
  label: string;
  src?: string;
  ratio?: string;
  class?: string;
}

const { label, src, ratio, class: className = '' } = Astro.props;
---

<figure class={`photo ${className}`} style={ratio ? `aspect-ratio: ${ratio};` : undefined} data-photo-label={label} data-photo-src={src}>
  {src ? (
    <>
      <img src={src} alt={label} loading="lazy" />
      <figcaption class="photo-tag">{label}</figcaption>
    </>
  ) : (
    <div class="photo-empty">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" stroke="currentColor" stroke-width="1" />
        <circle cx="9" cy="10" r="1.6" stroke="currentColor" stroke-width="1" />
        <path d="M3 16l5-4 4 3 3-2 6 4" stroke="currentColor" stroke-width="1" />
      </svg>
      <span>{label}</span>
    </div>
  )}
</figure>
