---
// Ajuste os dados de contato reais da Kazan.
const contato = {
  endereco: 'Campo Bom, RS',
  email: 'contato@kazan.com.br',
  telefone: '(51) 0000-0000'
};
---

<section class="section dark" id="contato">
  <div class="container">
    <div class="section-head reveal">
      <p class="label"><span>06</span>Contato</p>
      <h2 class="title">Vamos desenvolver sua próxima coleção.</h2>
    </div>

    <div class="contato-grid">
      <dl class="info reveal">
        <div>
          <dt class="label">Endereço</dt>
          <dd>{contato.endereco}</dd>
        </div>
        <div>
          <dt class="label">E-mail</dt>
          <dd><a href={`mailto:${contato.email}`}>{contato.email}</a></dd>
        </div>
        <div>
          <dt class="label">Telefone</dt>
          <dd>{contato.telefone}</dd>
        </div>
      </dl>

      <form class="form reveal" id="contatoForm">
        <div class="form-row">
          <input type="text" name="nome" placeholder="Nome" aria-label="Nome" required />
          <input type="text" name="empresa" placeholder="Empresa" aria-label="Empresa" required />
        </div>
        <div class="form-row">
          <input type="email" name="email" placeholder="E-mail" aria-label="E-mail" required />
          <input type="tel" name="telefone" placeholder="Telefone" aria-label="Telefone" />
        </div>
        <textarea name="mensagem" rows="3" placeholder="Mensagem" aria-label="Mensagem"></textarea>
        <div class="form-footer">
          <button type="submit" class="btn">Enviar</button>
          <p class="form-msg" id="formMsg" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<footer class="footer dark">
  <div class="container footer-inner">
    <img src="/images/logo-kazan.png" alt="KAZAN" class="footer-logo" />
    <p>© {new Date().getFullYear()} Kazan Indústria e Comércio Ltda. · Campo Bom, RS</p>
  </div>
</footer>

<style>
  .contato-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem var(--gutter);
    align-items: start;
  }

  .info {
    display: grid;
    gap: 1.75rem;
  }

  .info dd {
    margin-top: 0.35rem;
    font-size: 1rem;
  }

  .info a {
    text-decoration: none;
    border-bottom: 1px solid var(--kz-54);
  }

  .form {
    display: grid;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 0.9rem 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    color: var(--kz-eb);
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 300;
    outline: none;
    resize: vertical;
    transition: border-color 0.25s ease;
  }

  .form input::placeholder,
  .form textarea::placeholder {
    color: var(--kz-54);
  }

  .form input:focus,
  .form textarea:focus {
    border-color: var(--kz-eb);
  }

  .form-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .form-msg {
    font-size: 0.9rem;
    color: var(--kz-a9);
  }

  .footer {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-logo {
    height: 16px;
    width: auto;
  }

  .footer p {
    font-size: 0.78rem;
    color: var(--kz-54);
  }

  @media (max-width: 860px) {
    .contato-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contatoForm') as HTMLFormElement | null;
  const msg = document.getElementById('formMsg');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (msg) msg.textContent = 'Mensagem enviada. Retornaremos em breve.';
    form.reset();
  });
</script>
